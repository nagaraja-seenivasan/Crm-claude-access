    "test": "node --test \"dist/test/*.test.js\"",
    "bench": "node --test \"dist/test/bench.test.js\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "sla",
    "service-level-agreement",
    "business-hours",
    "reporting",
    "aggregation",
    "percentile",
    "p-square",
    "crm"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "~5.4.5"
  }
}
