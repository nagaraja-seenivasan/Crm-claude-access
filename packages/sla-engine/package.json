{
  "name": "@crm/sla-engine",
  "version": "1.0.0",
  "description": "High-performance, dependency-free SLA engine with a report-optimized streaming aggregation layer.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
